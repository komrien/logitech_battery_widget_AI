<Window x:Class="LogitechBatteryWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mouse Battery"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" Topmost="True"
        MouseLeftButtonDown="OnDragStart" MouseLeftButtonUp="OnDragEnd">
    <Border Background="#EE1E1F24" CornerRadius="10" Padding="14,10" MinWidth="240">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="새로고침" Click="OnRefresh"/>
                <MenuItem x:Name="TopmostItem" Header="항상 위" IsCheckable="True" Click="OnToggleTopmost"/>
                <Separator/>
                <MenuItem Header="종료" Click="OnExit"/>
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel x:Name="DeviceList"/>
    </Border>
</Window>
